@inproceedings{chang2026r2e,
  selected = {true},
  preview = {r2e-preview.png},
  title = {R\textsuperscript{2}E: A Role-driven Reward Evolutionary Framework for Automated Reward Function Design},
  author = {Shouhao Chang and Xuan Liu* and Hongye Zhu and Xinning Chen and Shigeng Zhang*},
  year = {2026},
  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},
  code = {https://github.com/ChangYuandao/R2E},
  abstract = {Designing effective reward functions is a critical challenge in reinforcement learning, and it still depends on costly manual trial and error. LLM-based methods often explore the reward space poorly and make training unstable, because candidates are sampled without distinction and past feedback is underused. R²E structures the search through three LLM roles: an Explorer that proposes novel rewards, a Guardian that makes conservative edits to stabilize training, and an Evolver that recombines strong rewards by crossover and mutation. A scheduler shifts the search from exploration to exploitation, and a Global Elite Pool keeps the best rewards so later iterations can build on them. Experiments on robotic tasks from Isaac Gym and Bi-DexHands show that the generated reward functions are effective.},
  description = {Sole first author. Specialized LLM roles and a Global Elite Pool search for reward functions that both perform well and train stably.},
  keywords = {Reinforcement Learning, Reward Design, Large Language Models, Robotics}
}
